{
  "name": "yh-launcher",
  "productName": "YH Launcher",
  "version": "1.0.0",
  "description": "YazılımHub topluluğunun Windows ve Linux için eklentilerle genişleyen uygulama başlatıcısı.",
  "main": "src/main/main.js",
  "homepage": "https://github.com/aytcode/YH-Launcher",
  "repository": "github:aytcode/YH-Launcher",
  "author": {
    "name": "YazılımHub",
    "email": "83597784+aytcode@users.noreply.github.com",
    "url": "https://discord.gg/yazilimhub"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "electron test/smoke.cjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.yazilimhub.launcher",
    "productName": "YH Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "YH-Launcher-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "YH Launcher",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "YH-Launcher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "yh-launcher",
      "artifactName": "YH-Launcher-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Eklentilerle genişleyen uygulama başlatıcısı",
      "maintainer": "YazılımHub <83597784+aytcode@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "YH Launcher",
          "Comment": "Uygulama, dosya, site ve komut ara",
          "Keywords": "launcher;search;başlatıcı;arama;yazilimhub;",
          "StartupWMClass": "YH Launcher"
        }
      }
    },
    "deb": {
      "recommends": [
        "libayatana-appindicator3-1"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
